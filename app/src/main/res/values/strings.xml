    <string name="privacy_title">Welcome to ZBProxy</string>
    <string name="privacy_subtitle">Before you start, please review the following</string>
    <string name="privacy_section_privacy">Privacy Policy</string>
    <string name="privacy_body">ZBProxy runs entirely on your device. We do NOT collect, store, upload or share any personal data.\n\n• All configuration is stored locally on your device\n• Proxy traffic is forwarded directly between your device and the target server\n• No analytics, no tracking, no ads\n• Logs are kept locally and can be cleared anytime</string>
